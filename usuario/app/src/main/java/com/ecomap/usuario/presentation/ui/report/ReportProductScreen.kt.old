package com.ecomap.usuario.presentation.ui.report

import android.Manifest
import android.content.pm.PackageManager
import android.location.Geocoder
import android.location.LocationManager
import android.net.Uri
import androidx.activity.compose.rememberLauncherForActivityResult
import androidx.activity.result.contract.ActivityResultContracts
import androidx.compose.foundation.background
import androidx.compose.foundation.layout.*
import androidx.compose.foundation.rememberScrollState
import androidx.compose.foundation.shape.RoundedCornerShape
import androidx.compose.foundation.verticalScroll
import androidx.compose.material.icons.Icons
import androidx.compose.material.icons.automirrored.filled.ArrowBack
import androidx.compose.material.icons.filled.*
import androidx.compose.material.icons.automirrored.filled.Send
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.ui.Alignment
import androidx.compose.ui.Modifier
import androidx.compose.ui.draw.clip
import androidx.compose.ui.graphics.Color
import androidx.compose.ui.layout.ContentScale
import androidx.compose.ui.text.font.FontWeight
import androidx.compose.ui.unit.dp
import androidx.core.content.ContextCompat
import coil.compose.AsyncImage
import com.ecomap.usuario.data.model.Business
import com.ecomap.usuario.data.model.ProductReport
import com.ecomap.usuario.presentation.viewmodel.BusinessUiState
import com.ecomap.usuario.presentation.viewmodel.BusinessViewModel
import com.ecomap.usuario.presentation.viewmodel.ReportUiState
import com.ecomap.usuario.ui.theme.NuColors
import com.google.accompanist.permissions.ExperimentalPermissionsApi
import com.google.accompanist.permissions.rememberMultiplePermissionsState
import io.github.jan.supabase.gotrue.Auth
import io.github.jan.supabase.gotrue.auth
import io.github.jan.supabase.SupabaseClient
import androidx.compose.ui.platform.LocalContext
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.launch
import kotlinx.coroutines.withContext
import java.util.Locale

@OptIn(ExperimentalMaterial3Api::class, ExperimentalPermissionsApi::class)
@Composable
fun ReportProductScreen(
    onNavigateBack: () -> Unit,
    productViewModel: com.ecomap.usuario.presentation.viewmodel.ProductViewModel = androidx.hilt.navigation.compose.hiltViewModel()
) {
    val context = LocalContext.current
    val uploadState by productViewModel.uploadState.collectAsState()
    val coroutineScope = rememberCoroutineScope()

    var productName by remember { mutableStateOf("") }
    var description by remember { mutableStateOf("") }
    var estimatedPrice by remember { mutableStateOf("") }
    var selectedImageUri by remember { mutableStateOf<Uri?>(null) }
    var showImagePickerDialog by remember { mutableStateOf(false) }

    // Categorías y unidades
    var selectedCategory by remember { mutableStateOf<com.ecomap.usuario.data.model.ProductCategory?>(null) }
    var selectedUnit by remember { mutableStateOf<com.ecomap.usuario.data.model.MeasurementUnit?>(null) }
    var showCategoryDialog by remember { mutableStateOf(false) }
    var showUnitDialog by remember { mutableStateOf(false) }

    // Estados de ubicación
    var userLatitude by remember { mutableStateOf<Double?>(null) }
    var userLongitude by remember { mutableStateOf<Double?>(null) }
    var userAddress by remember { mutableStateOf<String?>("Obteniendo ubicación...") }
    var isLoadingLocation by remember { mutableStateOf(false) }

    // Permisos de ubicación
    val locationPermissionState = rememberMultiplePermissionsState(
        permissions = listOf(
            Manifest.permission.ACCESS_FINE_LOCATION,
            Manifest.permission.ACCESS_COARSE_LOCATION
        )
    )

    // Función para obtener ubicación
    suspend fun getUserLocation() {
        isLoadingLocation = true
        try {
            val locationManager = context.getSystemService(android.content.Context.LOCATION_SERVICE) as LocationManager

            if (ContextCompat.checkSelfPermission(context, Manifest.permission.ACCESS_FINE_LOCATION) == PackageManager.PERMISSION_GRANTED ||
                ContextCompat.checkSelfPermission(context, Manifest.permission.ACCESS_COARSE_LOCATION) == PackageManager.PERMISSION_GRANTED) {

                val location = locationManager.getLastKnownLocation(LocationManager.GPS_PROVIDER)
                    ?: locationManager.getLastKnownLocation(LocationManager.NETWORK_PROVIDER)

                if (location != null) {
                    userLatitude = location.latitude
                    userLongitude = location.longitude

                    // Obtener dirección usando Geocoder
                    withContext(Dispatchers.IO) {
                        try {
                            val geocoder = Geocoder(context, Locale.getDefault())
                            val addresses = geocoder.getFromLocation(location.latitude, location.longitude, 1)
                            if (!addresses.isNullOrEmpty()) {
                                val address = addresses[0]
                                userAddress = buildString {
                                    if (address.thoroughfare != null) append("${address.thoroughfare}, ")
                                    if (address.locality != null) append("${address.locality}, ")
                                    if (address.adminArea != null) append(address.adminArea)
                                }
                            } else {
                                userAddress = "Lat: ${location.latitude}, Lon: ${location.longitude}"
                            }
                        } catch (e: Exception) {
                            userAddress = "Lat: ${location.latitude}, Lon: ${location.longitude}"
                        }
                    }
                } else {
                    userAddress = "No se pudo obtener ubicación"
                }
            }
        } catch (e: Exception) {
            userAddress = "Error al obtener ubicación"
        } finally {
            isLoadingLocation = false
        }
    }

    // Obtener ubicación al iniciar
    LaunchedEffect(Unit) {
        if (locationPermissionState.allPermissionsGranted) {
            getUserLocation()
        } else {
            userAddress = "Permisos de ubicación requeridos"
        }
    }

    // Manejar estados de subida
    LaunchedEffect(uploadState) {
        when (uploadState) {
            is com.ecomap.usuario.presentation.viewmodel.ProductUploadUiState.Success -> {
                // Limpiar campos
                productName = ""
                description = ""
                estimatedPrice = ""
                selectedImageUri = null
                // Resetear estado después de mostrar éxito
                kotlinx.coroutines.delay(2000)
                productViewModel.resetUploadState()
            }
            else -> {}
        }
    }

    val imagePickerLauncher = rememberLauncherForActivityResult(
        contract = ActivityResultContracts.GetContent()
    ) { uri: Uri? ->
        selectedImageUri = uri
    }

    val cameraLauncher = rememberLauncherForActivityResult(
        contract = ActivityResultContracts.TakePicture()
    ) { success ->
        if (!success) {
            selectedImageUri = null
        }
    }

    Scaffold(
        topBar = {
            TopAppBar(
                title = { Text("Publicar Producto", fontWeight = FontWeight.Bold) },
                navigationIcon = {
                    IconButton(onClick = onNavigateBack) {
                        Icon(Icons.AutoMirrored.Filled.ArrowBack, "Volver")
                    }
                },
                colors = TopAppBarDefaults.topAppBarColors(
                    containerColor = MaterialTheme.colorScheme.surface
                )
            )
        }
    ) { padding ->
        Column(
            modifier = Modifier
                .fillMaxSize()
                .padding(padding)
                .verticalScroll(rememberScrollState())
                .padding(24.dp),
            verticalArrangement = Arrangement.spacedBy(20.dp)
        ) {
            // Información
            Card(
                modifier = Modifier.fillMaxWidth(),
                colors = CardDefaults.cardColors(
                    containerColor = NuColors.Info.copy(alpha = 0.1f)
                ),
                shape = RoundedCornerShape(16.dp)
            ) {
                Row(
                    modifier = Modifier.padding(16.dp),
                    horizontalArrangement = Arrangement.spacedBy(12.dp),
                    verticalAlignment = Alignment.Top
                ) {
                    Icon(
                        Icons.Default.Info,
                        contentDescription = null,
                        tint = NuColors.Info
                    )
                    Text(
                        text = "Comparte productos con la comunidad. Otros usuarios podrán verlos en el marketplace comunitario.",
                        style = MaterialTheme.typography.bodyMedium,
                        color = NuColors.TextSecondary
                    )
                }
            }

            // Categoría del producto
            OutlinedCard(
                onClick = { showCategoryDialog = true },
                modifier = Modifier.fillMaxWidth(),
                shape = RoundedCornerShape(12.dp),
                colors = CardDefaults.outlinedCardColors(
                    containerColor = if (selectedCategory != null) NuColors.Primary.copy(alpha = 0.05f) else Color.Transparent
                )
            ) {
                Row(
                    modifier = Modifier
                        .fillMaxWidth()
                        .padding(16.dp),
                    horizontalArrangement = Arrangement.spacedBy(12.dp),
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    Icon(
                        Icons.Default.Category,
                        contentDescription = null,
                        tint = if (selectedCategory != null) NuColors.Primary else NuColors.TextSecondary
                    )
                    Column(modifier = Modifier.weight(1f)) {
                        Text(
                            text = if (selectedCategory != null) "Categoría" else "Seleccionar categoría",
                            style = MaterialTheme.typography.labelMedium,
                            color = NuColors.TextSecondary
                        )
                        if (selectedCategory != null) {
                            Text(
                                text = "${selectedCategory!!.icon} ${selectedCategory!!.name}",
                                style = MaterialTheme.typography.bodyLarge,
                                fontWeight = FontWeight.Medium
                            )
                        }
                    }
                    Icon(
                        Icons.Default.ArrowDropDown,
                        contentDescription = null,
                        tint = NuColors.TextSecondary
                    )
                }
            }

            // Unidad de medida (solo si hay categoría seleccionada)
            if (selectedCategory != null) {
                OutlinedCard(
                    onClick = { showUnitDialog = true },
                    modifier = Modifier.fillMaxWidth(),
                    shape = RoundedCornerShape(12.dp),
                    colors = CardDefaults.outlinedCardColors(
                        containerColor = if (selectedUnit != null) NuColors.Info.copy(alpha = 0.05f) else Color.Transparent
                    )
                ) {
                    Row(
                        modifier = Modifier
                            .fillMaxWidth()
                            .padding(16.dp),
                        horizontalArrangement = Arrangement.spacedBy(12.dp),
                        verticalAlignment = Alignment.CenterVertically
                    ) {
                        Icon(
                            Icons.Default.Scale,
                            contentDescription = null,
                            tint = if (selectedUnit != null) NuColors.Info else NuColors.TextSecondary
                        )
                        Column(modifier = Modifier.weight(1f)) {
                            Text(
                                text = if (selectedUnit != null) "Unidad de medida" else "Seleccionar unidad",
                                style = MaterialTheme.typography.labelMedium,
                                color = NuColors.TextSecondary
                            )
                            if (selectedUnit != null) {
                                Text(
                                    text = "${selectedUnit!!.name} (${selectedUnit!!.abbreviation})",
                                    style = MaterialTheme.typography.bodyLarge,
                                    fontWeight = FontWeight.Medium
                                )
                            }
                        }
                        Icon(
                            Icons.Default.ArrowDropDown,
                            contentDescription = null,
                            tint = NuColors.TextSecondary
                        )
                    }
                }
            }

            // Nombre del producto
            OutlinedTextField(
                value = productName,
                onValueChange = { productName = it },
                label = { Text("Nombre del producto") },
                modifier = Modifier.fillMaxWidth(),
                shape = RoundedCornerShape(12.dp),
                leadingIcon = { Icon(Icons.Default.ShoppingBag, null) }
            )

            // Descripción
            OutlinedTextField(
                value = description,
                onValueChange = { description = it },
                label = { Text("Descripción (opcional)") },
                modifier = Modifier.fillMaxWidth(),
                shape = RoundedCornerShape(12.dp),
                minLines = 3,
                maxLines = 5
            )

            // Precio estimado
            OutlinedTextField(
                value = estimatedPrice,
                onValueChange = { estimatedPrice = it.filter { char -> char.isDigit() || char == '.' } },
                label = { Text("Precio aproximado") },
                modifier = Modifier.fillMaxWidth(),
                shape = RoundedCornerShape(12.dp),
                leadingIcon = { Icon(Icons.Default.AttachMoney, null) },
                prefix = { Text("$") }
            )

            // Ubicación
            Card(
                modifier = Modifier.fillMaxWidth(),
                colors = CardDefaults.cardColors(
                    containerColor = if (userLatitude != null && userLongitude != null)
                        NuColors.Success.copy(alpha = 0.1f)
                    else
                        NuColors.Warning.copy(alpha = 0.1f)
                ),
                shape = RoundedCornerShape(16.dp)
            ) {
                Row(
                    modifier = Modifier
                        .fillMaxWidth()
                        .padding(16.dp),
                    horizontalArrangement = Arrangement.spacedBy(12.dp),
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    Icon(
                        Icons.Default.LocationOn,
                        contentDescription = null,
                        tint = if (userLatitude != null && userLongitude != null)
                            NuColors.Success
                        else
                            NuColors.Warning,
                        modifier = Modifier.size(24.dp)
                    )
                    Column(modifier = Modifier.weight(1f)) {
                        Text(
                            text = "Ubicación del producto",
                            style = MaterialTheme.typography.titleSmall,
                            fontWeight = FontWeight.Bold
                        )
                        Text(
                            text = userAddress ?: "Ubicación no disponible",
                            style = MaterialTheme.typography.bodySmall,
                            color = NuColors.TextSecondary
                        )
                    }
                    if (isLoadingLocation) {
                        CircularProgressIndicator(
                            modifier = Modifier.size(20.dp),
                            strokeWidth = 2.dp
                        )
                    } else if (userLatitude == null || userLongitude == null) {
                        IconButton(
                            onClick = {
                                if (locationPermissionState.allPermissionsGranted) {
                                    coroutineScope.launch {
                                        getUserLocation()
                                    }
                                } else {
                                    locationPermissionState.launchMultiplePermissionRequest()
                                }
                            }
                        ) {
                            Icon(
                                Icons.Default.Refresh,
                                contentDescription = "Reintentar",
                                tint = NuColors.Primary
                            )
                        }
                    }
                }
            }

            // Imagen
            Column(
                modifier = Modifier.fillMaxWidth(),
                verticalArrangement = Arrangement.spacedBy(12.dp)
            ) {
                Text(
                    "Foto del producto (opcional)",
                    style = MaterialTheme.typography.titleSmall,
                    fontWeight = FontWeight.Medium
                )

                if (selectedImageUri != null) {
                    Box(
                        modifier = Modifier
                            .fillMaxWidth()
                            .height(200.dp)
                            .clip(RoundedCornerShape(16.dp))
                            .background(NuColors.SurfaceVariant)
                    ) {
                        AsyncImage(
                            model = selectedImageUri,
                            contentDescription = "Foto del producto",
                            modifier = Modifier.fillMaxSize(),
                            contentScale = ContentScale.Crop
                        )
                        IconButton(
                            onClick = { selectedImageUri = null },
                            modifier = Modifier
                                .align(Alignment.TopEnd)
                                .padding(8.dp)
                                .background(Color.Black.copy(alpha = 0.5f), RoundedCornerShape(50))
                        ) {
                            Icon(
                                Icons.Default.Close,
                                "Quitar imagen",
                                tint = Color.White
                            )
                        }
                    }
                } else {
                    OutlinedButton(
                        onClick = { showImagePickerDialog = true },
                        modifier = Modifier
                            .fillMaxWidth()
                            .height(120.dp),
                        shape = RoundedCornerShape(16.dp)
                    ) {
                        Column(
                            horizontalAlignment = Alignment.CenterHorizontally,
                            verticalArrangement = Arrangement.spacedBy(8.dp)
                        ) {
                            Icon(Icons.Default.AddAPhoto, null, modifier = Modifier.size(32.dp))
                            Text("Tomar o seleccionar foto")
                        }
                    }
                }
            }

            Spacer(Modifier.height(8.dp))

            // Mensaje de estado
            when (uploadState) {
                is com.ecomap.usuario.presentation.viewmodel.ProductUploadUiState.Success -> {
                    Card(
                        modifier = Modifier.fillMaxWidth(),
                        colors = CardDefaults.cardColors(
                            containerColor = NuColors.Success.copy(alpha = 0.1f)
                        ),
                        shape = RoundedCornerShape(12.dp)
                    ) {
                        Row(
                            modifier = Modifier.padding(16.dp),
                            horizontalArrangement = Arrangement.spacedBy(12.dp),
                            verticalAlignment = Alignment.CenterVertically
                        ) {
                            Icon(Icons.Default.CheckCircle, null, tint = NuColors.Success)
                            Text(
                                (uploadState as com.ecomap.usuario.presentation.viewmodel.ProductUploadUiState.Success).message,
                                color = NuColors.Success,
                                fontWeight = FontWeight.Medium
                            )
                        }
                    }
                }
                is com.ecomap.usuario.presentation.viewmodel.ProductUploadUiState.Error -> {
                    Card(
                        modifier = Modifier.fillMaxWidth(),
                        colors = CardDefaults.cardColors(
                            containerColor = NuColors.Error.copy(alpha = 0.1f)
                        ),
                        shape = RoundedCornerShape(12.dp)
                    ) {
                        Row(
                            modifier = Modifier.padding(16.dp),
                            horizontalArrangement = Arrangement.spacedBy(12.dp),
                            verticalAlignment = Alignment.CenterVertically
                        ) {
                            Icon(Icons.Default.Error, null, tint = NuColors.Error)
                            Text(
                                (uploadState as com.ecomap.usuario.presentation.viewmodel.ProductUploadUiState.Error).message,
                                color = NuColors.Error
                            )
                        }
                    }
                }
                else -> {}
            }

            // Botón enviar
            Button(
                onClick = {
                    val price = estimatedPrice.toDoubleOrNull() ?: 0.0
                    val latitude = userLatitude ?: 0.0
                    val longitude = userLongitude ?: 0.0
                    val unitType = selectedUnit?.abbreviation ?: "unit"

                    productViewModel.uploadProduct(
                        name = productName,
                        description = description.ifBlank { null },
                        price = price,
                        imageUri = selectedImageUri,
                        latitude = latitude,
                        longitude = longitude,
                        address = userAddress,
                        unitType = unitType
                    )
                },
                modifier = Modifier
                    .fillMaxWidth()
                    .height(56.dp),
                enabled = productName.isNotBlank() &&
                         estimatedPrice.isNotBlank() &&
                         selectedCategory != null &&
                         selectedUnit != null &&
                         userLatitude != null &&
                         userLongitude != null &&
                         uploadState !is com.ecomap.usuario.presentation.viewmodel.ProductUploadUiState.Loading,
                shape = RoundedCornerShape(28.dp),
                colors = ButtonDefaults.buttonColors(
                    containerColor = NuColors.Primary,
                    contentColor = Color.White
                )
            ) {
                if (uploadState is com.ecomap.usuario.presentation.viewmodel.ProductUploadUiState.Loading) {
                    CircularProgressIndicator(
                        modifier = Modifier.size(24.dp),
                        color = Color.White,
                        strokeWidth = 2.dp
                    )
                } else {
                    Icon(Icons.AutoMirrored.Filled.Send, null)
                    Spacer(Modifier.width(8.dp))
                    Text("Publicar Producto", fontWeight = FontWeight.Bold)
                }
            }
        }
    }

    // Diálogo selector de categoría
    if (showCategoryDialog) {
        AlertDialog(
            onDismissRequest = { showCategoryDialog = false },
            title = {
                Text(
                    "Seleccionar Categoría",
                    fontWeight = FontWeight.Bold,
                    style = MaterialTheme.typography.titleLarge
                )
            },
            text = {
                Column(
                    modifier = Modifier.fillMaxWidth(),
                    verticalArrangement = Arrangement.spacedBy(8.dp)
                ) {
                    com.ecomap.usuario.data.model.ProductCategories.categories.forEach { category ->
                        OutlinedCard(
                            onClick = {
                                selectedCategory = category
                                selectedUnit = null // Resetear unidad al cambiar categoría
                                showCategoryDialog = false
                            },
                            modifier = Modifier.fillMaxWidth(),
                            shape = RoundedCornerShape(12.dp),
                            colors = CardDefaults.outlinedCardColors(
                                containerColor = if (selectedCategory == category)
                                    NuColors.Primary.copy(alpha = 0.1f)
                                else
                                    Color.Transparent
                            )
                        ) {
                            Row(
                                modifier = Modifier
                                    .fillMaxWidth()
                                    .padding(16.dp),
                                verticalAlignment = Alignment.CenterVertically,
                                horizontalArrangement = Arrangement.spacedBy(12.dp)
                            ) {
                                Text(
                                    text = category.icon,
                                    style = MaterialTheme.typography.headlineMedium
                                )
                                Text(
                                    text = category.name,
                                    style = MaterialTheme.typography.bodyLarge,
                                    fontWeight = if (selectedCategory == category) FontWeight.Bold else FontWeight.Normal
                                )
                            }
                        }
                    }
                }
            },
            confirmButton = {},
            dismissButton = {
                TextButton(onClick = { showCategoryDialog = false }) {
                    Text("Cancelar", color = NuColors.TextSecondary)
                }
            },
            shape = RoundedCornerShape(24.dp)
        )
    }

    // Diálogo selector de unidad
    if (showUnitDialog && selectedCategory != null) {
        AlertDialog(
            onDismissRequest = { showUnitDialog = false },
            title = {
                Text(
                    "Seleccionar Unidad de Medida",
                    fontWeight = FontWeight.Bold,
                    style = MaterialTheme.typography.titleLarge
                )
            },
            text = {
                Column(
                    modifier = Modifier.fillMaxWidth(),
                    verticalArrangement = Arrangement.spacedBy(8.dp)
                ) {
                    selectedCategory!!.units.forEach { unit ->
                        OutlinedCard(
                            onClick = {
                                selectedUnit = unit
                                showUnitDialog = false
                            },
                            modifier = Modifier.fillMaxWidth(),
                            shape = RoundedCornerShape(12.dp),
                            colors = CardDefaults.outlinedCardColors(
                                containerColor = if (selectedUnit == unit)
                                    NuColors.Info.copy(alpha = 0.1f)
                                else
                                    Color.Transparent
                            )
                        ) {
                            Row(
                                modifier = Modifier
                                    .fillMaxWidth()
                                    .padding(16.dp),
                                verticalAlignment = Alignment.CenterVertically,
                                horizontalArrangement = Arrangement.spacedBy(12.dp)
                            ) {
                                Icon(
                                    Icons.Default.Scale,
                                    contentDescription = null,
                                    tint = if (selectedUnit == unit) NuColors.Info else NuColors.TextSecondary
                                )
                                Column(modifier = Modifier.weight(1f)) {
                                    Text(
                                        text = unit.name,
                                        style = MaterialTheme.typography.bodyLarge,
                                        fontWeight = if (selectedUnit == unit) FontWeight.Bold else FontWeight.Normal
                                    )
                                    Text(
                                        text = unit.abbreviation,
                                        style = MaterialTheme.typography.bodySmall,
                                        color = NuColors.TextSecondary
                                    )
                                }
                            }
                        }
                    }
                }
            },
            confirmButton = {},
            dismissButton = {
                TextButton(onClick = { showUnitDialog = false }) {
                    Text("Cancelar", color = NuColors.TextSecondary)
                }
            },
            shape = RoundedCornerShape(24.dp)
        )
    }

    // Diálogo selector de imagen (Cámara o Galería)
    if (showImagePickerDialog) {
        AlertDialog(
            onDismissRequest = { showImagePickerDialog = false },
            title = {
                Text(
                    "Agregar Foto",
                    fontWeight = FontWeight.Bold,
                    style = MaterialTheme.typography.titleLarge
                )
            },
            text = {
                Column(
                    modifier = Modifier.fillMaxWidth(),
                    verticalArrangement = Arrangement.spacedBy(12.dp)
                ) {
                    // Opción Cámara
                    OutlinedCard(
                        onClick = {
                            val photoFile = java.io.File(
                                context.cacheDir,
                                "product_${System.currentTimeMillis()}.jpg"
                            )
                            selectedImageUri = androidx.core.content.FileProvider.getUriForFile(
                                context,
                                "${context.packageName}.fileprovider",
                                photoFile
                            )
                            cameraLauncher.launch(selectedImageUri!!)
                            showImagePickerDialog = false
                        },
                        modifier = Modifier.fillMaxWidth(),
                        shape = RoundedCornerShape(16.dp),
                        colors = CardDefaults.outlinedCardColors(
                            containerColor = NuColors.Primary.copy(alpha = 0.05f)
                        )
                    ) {
                        Row(
                            modifier = Modifier
                                .fillMaxWidth()
                                .padding(16.dp),
                            verticalAlignment = Alignment.CenterVertically,
                            horizontalArrangement = Arrangement.spacedBy(16.dp)
                        ) {
                            Box(
                                modifier = Modifier
                                    .size(48.dp)
                                    .clip(RoundedCornerShape(12.dp))
                                    .background(NuColors.Primary.copy(alpha = 0.15f)),
                                contentAlignment = Alignment.Center
                            ) {
                                Icon(
                                    Icons.Default.CameraAlt,
                                    contentDescription = null,
                                    tint = NuColors.Primary,
                                    modifier = Modifier.size(24.dp)
                                )
                            }
                            Column {
                                Text(
                                    "Tomar Foto",
                                    fontWeight = FontWeight.Bold,
                                    style = MaterialTheme.typography.bodyLarge
                                )
                                Text(
                                    "Abrir cámara",
                                    style = MaterialTheme.typography.bodySmall,
                                    color = NuColors.TextSecondary
                                )
                            }
                        }
                    }

                    // Opción Galería
                    OutlinedCard(
                        onClick = {
                            imagePickerLauncher.launch("image/*")
                            showImagePickerDialog = false
                        },
                        modifier = Modifier.fillMaxWidth(),
                        shape = RoundedCornerShape(16.dp),
                        colors = CardDefaults.outlinedCardColors(
                            containerColor = NuColors.Info.copy(alpha = 0.05f)
                        )
                    ) {
                        Row(
                            modifier = Modifier
                                .fillMaxWidth()
                                .padding(16.dp),
                            verticalAlignment = Alignment.CenterVertically,
                            horizontalArrangement = Arrangement.spacedBy(16.dp)
                        ) {
                            Box(
                                modifier = Modifier
                                    .size(48.dp)
                                    .clip(RoundedCornerShape(12.dp))
                                    .background(NuColors.Info.copy(alpha = 0.15f)),
                                contentAlignment = Alignment.Center
                            ) {
                                Icon(
                                    Icons.Default.Photo,
                                    contentDescription = null,
                                    tint = NuColors.Info,
                                    modifier = Modifier.size(24.dp)
                                )
                            }
                            Column {
                                Text(
                                    "Seleccionar de Galería",
                                    fontWeight = FontWeight.Bold,
                                    style = MaterialTheme.typography.bodyLarge
                                )
                                Text(
                                    "Elegir foto existente",
                                    style = MaterialTheme.typography.bodySmall,
                                    color = NuColors.TextSecondary
                                )
                            }
                        }
                    }
                }
            },
            confirmButton = {},
            dismissButton = {
                TextButton(onClick = { showImagePickerDialog = false }) {
                    Text("Cancelar", color = NuColors.TextSecondary)
                }
            },
            shape = RoundedCornerShape(24.dp)
        )
    }
}
